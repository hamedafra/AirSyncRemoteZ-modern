                <Button android:id="@id/remote_number_eights" android:background="@drawable/remote_number_eight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6.0dp" />
                <Button android:id="@id/remote_number_nines" android:background="@drawable/remote_number_nine" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6.0dp" />
            </TableRow>
            <TableRow android:gravity="center_horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6.0dp">
                <Button android:textSize="24.0sp" android:textColor="@color/white" android:id="@id/remote_number_ok" android:background="@drawable/remote_number_ok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/remote_number_done" />
                <Button android:id="@id/remote_number_zeros" android:background="@drawable/remote_number_zero" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6.0dp" />
                <Button android:id="@id/remote_number_del" android:background="@drawable/remote_number_del" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6.0dp" />
            </TableRow>
        </TableLayout>
        <Button android:textSize="24.0sp" android:textColor="@color/white" android:id="@id/remote_number_stay" android:background="@drawable/remote_number_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6.0dp" android:text="@string/remote_stay" />
    </LinearLayout>
</LinearLayout>
