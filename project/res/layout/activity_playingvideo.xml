        <LinearLayout android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toLeftOf="@id/rc_push" android:layout_toRightOf="@id/rc_back" android:layout_centerVertical="true">
            <TextView android:textSize="20.0sp" android:textStyle="bold" android:textColor="#fff" android:gravity="center" android:id="@id/viewFlipper" android:paddingLeft="5.0dp" android:paddingRight="5.0dp" android:paddingBottom="2.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout android:id="@id/rc_onlive_portrait_epg" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:id="@id/rc_video_guid_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" />
