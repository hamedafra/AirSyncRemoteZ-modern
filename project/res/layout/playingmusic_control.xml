            <SeekBar android:id="@id/sb_duration" android:paddingLeft="10.0dp" android:paddingRight="10.0dp" android:focusable="true" android:focusableInTouchMode="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxHeight="10.0dp" android:progressDrawable="@drawable/rc_seekbar" android:minHeight="10.0dp" android:thumb="@drawable/rc_seekbar_thumb" android:layout_centerVertical="true" />
